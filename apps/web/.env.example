# Frontend values are public. Keep keys in model settings, not VITE_ variables.
VITE_REALTIME_WS_URL=
VITE_FORCE_MOCK_AUTH=false

# The public analysis API uses the key from model settings. It does not fall back to this value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ALLOWED_ORIGIN=
# Require an Identity JWT for /api/analysis and /api/ast/probe.
IDENTITY_REQUIRED=true
# Extra https hosts for a caller's OpenAI-compatible Base URL. api.openai.com is always allowed.
# ALLOWED_MODEL_HOSTS=
