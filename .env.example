# Legacy fallback. Prefer apps/desktop/.env or apps/web/.env for independent configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

VITE_REALTIME_WS_URL=
VITE_FORCE_MOCK_AUTH=true

ALLOWED_ORIGIN=

# Production Netlify must require an Identity JWT for analysis and speech probe APIs.
IDENTITY_REQUIRED=true
# Extra https hosts for a caller's OpenAI-compatible Base URL. api.openai.com is always allowed.
# ALLOWED_MODEL_HOSTS=
