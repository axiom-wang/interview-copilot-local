{
  "name": "interview-copilot-local",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:electron",
    "build:web": "tsc -p tsconfig.app.json && tsc -p tsconfig.functions.json && vite build --mode web",
    "build:electron": "tsc -b && vite build",
    "build:realtime": "tsc -p tsconfig.realtime.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:realtime": "tsx realtime/server.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "protobufjs": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@netlify/functions": "^5.2.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.1",
    "wait-on": "^9.0.4"
  }
}
