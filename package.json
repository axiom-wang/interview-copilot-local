{
  "name": "interview-copilot-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:desktop": "npm run dev --workspace @meeting-assistant/desktop",
    "dev:web": "npm run dev --workspace @meeting-assistant/web",
    "build": "npm run build:desktop",
    "build:desktop": "npm run build --workspace @meeting-assistant/desktop",
    "build:electron": "npm run build:desktop",
    "build:web": "npm run build --workspace @meeting-assistant/web",
    "build:realtime": "npm run build:realtime --workspace @meeting-assistant/web",
    "start:realtime": "npm run start:realtime --workspace @meeting-assistant/web",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "npm run preview:web",
    "preview:web": "npm run preview --workspace @meeting-assistant/web"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.0",
    "typescript": "~6.0.2",
    "tsx": "^4.21.0",
    "@types/node": "^24.12.2"
  },
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "packageManager": "pnpm@12.8.1"
}
